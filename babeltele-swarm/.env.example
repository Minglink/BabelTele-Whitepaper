# BabelTele Swarm (@babeltele/swarm) Environment Configuration

# Web War-Room Server Port (default: 3722)
PORT=3722

# Optional LLM Engine Configuration (for Real LLM Mode: DeepSeek / Qwen / OpenAI / Ollama)
# Leave blank to use the built-in Showcase Simulator ("demo-sim") or configure interactively in the Web UI.
LLM_ENGINE=demo-sim
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Local Ollama Endpoint (auto-detected via /api/ollama/detect)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
