# BabelTele Studio — Environment Configuration (.env.example)
# Copy this file to `.env` to configure default upstream LLM / Relay endpoints.

# OpenAI-Compatible API Base URL
# Examples:
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama:    http://127.0.0.1:11434/v1
#   LM Studio: http://127.0.0.1:1234/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# API Key (leave empty or "ollama" when using local Ollama / LM Studio)
OPENAI_API_KEY=

# Default Compiler / Relay Model Name
# Examples: deepseek-chat, qwen-plus, gpt-4o-mini, qwen2.5:3b, llama3.2
OPENAI_MODEL=deepseek-chat

# Web Studio HTTP Server Port
PORT=3721
